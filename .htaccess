Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(shared-app\.php|README\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always use shared assets, even when an old assets directory still exists.
  RewriteRule ^assets/([a-zA-Z0-9_-]+\.(css|js|svg))$ asset.php?file=$1 [QSA,L]
  RewriteRule ^api(?:/.*)?$ - [R=404,L]
  RewriteRule ^(?:tests|scripts)/ - [R=404,L]
</IfModule>

# The legacy domain entry also loads this adapter; always revalidate it.
<IfModule mod_headers.c>
  <Files "backend.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
